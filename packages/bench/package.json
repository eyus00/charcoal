{
  "name": "@charcoal/bench",
  "version": "0.1.0",
  "private": true,
  "description": "Source-availability benchmark: a fixed title set, per-provider outcomes, stream validation, playback-start checks, comparable reports",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "bench": "tsx src/cli.ts run",
    "report": "tsx src/cli.ts report"
  },
  "dependencies": {
    "@charcoal/provider-sdk": "*",
    "@charcoal/providers": "*"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
