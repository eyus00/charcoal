# Server Configuration
PORT=3000              # Railway provides its own PORT, this will be overridden
HOST=0.0.0.0           # Must be 0.0.0.0 so Railway can expose your server
NODE_ENV=production    # Use 'production' for deployed server

# TMDB Configuration
TMDB_API_KEY=50404130561567acf3e0725aeb09ec5d
TMDB_CACHE_TTL=86400   # 24 hours cache, fine for free tier

# Cache Configuration
CACHE_TYPE=memory      # Free tier uses in-memory cache only

# Redis Configuration (not used on free tier)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Public URL (your Railway URL)
PUBLIC_URL=https://your-railway-project.up.railway.app
