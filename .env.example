# Railway sets PORT automatically
HOST=0.0.0.0
NODE_ENV=production
TMDB_API_KEY=your_tmdb_api_key_here
# Max time a single provider may take before it is skipped (ms)
PROVIDER_TIMEOUT_MS=15000
# Restrict to your frontend origin in production, e.g. https://charcoal.eys0.fyi
CORS_ORIGIN=*
CACHE_TYPE=memory
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# Drop HLS sources whose segments this server is blocked from (leave off if you
# play through a separate stream proxy such as the Cloudflare Worker)
VALIDATE_SEGMENTS=false
