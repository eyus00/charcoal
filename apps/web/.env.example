# TMDB (v3 API key). Used in the browser, so it is public by nature.
VITE_TMDB_API_KEY=50404130561567acf3e0725aeb09ec5d

# Jelly scraper base URL (no trailing slash, no /v1)
VITE_JELLY_URL=https://jelly.up.railway.app

# Public keys this build trusts for the provider registry, as keyId=base64 pairs (comma-separated).
# With keys set, the site only accepts a registry signed by one of them. Unset: the registry of
# the resolver it already talks to is accepted unsigned.
# VITE_REGISTRY_KEYS=release-2026=BASE64_PUBLIC_KEY
