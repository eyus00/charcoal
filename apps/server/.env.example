# Railway sets PORT automatically
HOST=0.0.0.0
NODE_ENV=production
TMDB_API_KEY=your_tmdb_api_key_here
# Max time a single provider may take before it is skipped (ms)
PROVIDER_TIMEOUT_MS=15000
# Restrict to your frontend origin in production, e.g. https://charcoal.eys0.fyi
CORS_ORIGIN=*
CACHE_TYPE=memory
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# Drop HLS sources whose segments this server is blocked from (leave off if you
# play through a separate stream proxy)
VALIDATE_SEGMENTS=false
# Stream proxy: how long to wait for an upstream to start answering (ms)
PROXY_HEADER_TIMEOUT_MS=15000
# Allow proxying to private/internal addresses (local testing only, never in production)
PROXY_ALLOW_PRIVATE=false
# Provider health: failures in a row before a provider sits out, and the first cooldown (ms;
# doubles each time, max 1 hour). See GET /v1/providers/health
HEALTH_FAILS_TO_BENCH=3
HEALTH_COOLDOWN_MS=300000
