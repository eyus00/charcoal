# Railway sets PORT automatically
HOST=0.0.0.0
NODE_ENV=production
TMDB_API_KEY=your_tmdb_api_key_here
# Max time a single provider may take before it is skipped (ms)
PROVIDER_TIMEOUT_MS=15000
# Restrict to your frontend origin in production, e.g. https://charcoal.eys0.fyi
CORS_ORIGIN=*
CACHE_TYPE=memory
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# Drop HLS sources whose segments this server is blocked from (leave off if you
# play through a separate stream proxy)
VALIDATE_SEGMENTS=false
# Stream proxy: how long to wait for an upstream to start answering (ms)
PROXY_HEADER_TIMEOUT_MS=15000
# Allow proxying to private/internal addresses (local testing only, never in production)
PROXY_ALLOW_PRIVATE=false
# Provider health: failures in a row before a provider sits out, and the first cooldown (ms;
# doubles each time, max 1 hour). See GET /v1/providers/health
HEALTH_FAILS_TO_BENCH=3
HEALTH_COOLDOWN_MS=300000
# StreamViva's providers as a fallback (they mostly fail from data centres, and provider health
# benches them there; on a server at home they can work). Set to false to leave them out.
STREAMVIVA=true
# Febbox (original files up to 4K) on YOUR OWN server: your Febbox "ui" cookie value. Only set this
# on a server you run for yourself (it plays from your account and its 100 GB monthly traffic).
# FEBBOX_TOKEN=
# Highest Febbox quality to use (e.g. 1080), to save traffic; empty = up to 4K
# FEBBOX_MAX_HEIGHT=

# ---------- provider platform (/v2) ----------
# Where the platform keeps its small state files (health snapshot, control-plane overrides).
# Unset = memory only (state is lost on restart). On Railway, mount a volume and point this at it.
# DATA_DIR=/data
# This server runs on a home connection: providers that only work from a viewer's own network
# are then run here too. Leave unset on a hosted server.
# EGRESS=user
# The control plane (/v2/admin/*): enable/disable providers, change ranks and domains, roll back.
# The endpoints don't exist unless this is set. Use a long random value.
# ADMIN_TOKEN=
# Sign the registry this server publishes (base64 PKCS#8 Ed25519 key from `npm run registry -- keygen`).
# Clients built with the matching public key (VITE_REGISTRY_KEYS) then accept nothing else.
# REGISTRY_PRIVATE_KEY=
# REGISTRY_KEY_ID=release-2026
# Other places the same registry is published (static mirrors), comma-separated.
# REGISTRY_MIRRORS=
# The relay (/v1/proxy, /v2/relay) only serves links this server signed. Set the secret when
# running more than one instance (otherwise each instance makes its own at start).
# RELAY_SECRET=
# RELAY_TTL_SECONDS=43200
# Accept unsigned relay links too (only while older clients are still around).
# RELAY_REQUIRE_SIGNATURE=true
# Scheduled monitoring: checks every provider with known titles, classifies what is wrong and
# restores what works again. Minutes between runs; 0 turns it off.
MONITOR_INTERVAL_MINUTES=30
# Let monitoring switch to an already-configured alternate domain by itself when the active one
# is down and the alternate passes a real extraction. The switch is temporary (this many minutes)
# and audited. 0 = only propose it (see GET /v2/health, POST /v2/admin/providers/:id/proposal).
AUTO_DOMAIN_FAILOVER_MINUTES=0
# Refuse to run providers whose network policy isn't a declared allow-list (legacy classes and
# the vendored fallback pack). Stricter, and fewer sources.
# STRICT_PROVIDER_NETWORK=false
# One JSON log line per provider run (outcome, code, ms, requests).
# PLATFORM_LOG=false
# Searches per client address: sustained rate per minute, and how many may arrive at once.
# RATE_LIMIT_SOURCES_PER_MINUTE=60
# RATE_LIMIT_SOURCES_BURST=20

# ---------- Verification and the browser runtime ----------
# Try each discovered stream from the server (manifest + first media bytes, never a download)
# and report it as verified or not. On by default.
# VERIFY_STREAMS=false

# A browser for providers that need page JavaScript (docs/platform/BROWSER.md).
# Either launch Chromium in this container (build the image with --build-arg WITH_BROWSER=true)…
# BROWSER_WORKER=local
# …or connect to a browser running in its own container.
# BROWSER_WS_ENDPOINT=ws://browser:3000/
# BROWSER_WS_PROTOCOL=playwright
# BROWSER_EXECUTABLE=
# BROWSER_MAX_SESSIONS=2
